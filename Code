
# ============================================================
# MINI JUEGO DIDÁCTICO - REN'PY
# ============================================================

define osi = Character("Osiris", color="#DA6FF7")
define led = Character("Ledesma", color="#20FAF2")
define mk = Character("Mankito", color="#5A21ED")


# ------------------------------------------------------------
# SPRITES
# ------------------------------------------------------------

image chico = "images/chico.png"
image chico enfadado = "images/chicoenfadado.png"
image chico sonrie = "images/chicosonrie.png"
image chica = "images/chica.png"

# Mismo sprite, volteado horizontalmente
image chico volteado = im.Flip("images/chico.png", horizontal=True)


# ------------------------------------------------------------
# TRANSFORMACIONES: POSICIÓN
# ------------------------------------------------------------

transform izquierda:
    xalign 0.25
    yalign 1.0

transform derecha:
    xalign 0.75
    yalign 1.0

transform centro:
    xalign 0.5
    yalign 1.0


# ============================================================
# INICIO
# ============================================================

label start:

    # Cambiar fondo
    scene atardecer
    play music "music/sovereign.mp3" loop fadein 1.0

    "Mankito tenía una idea. Eso nunca era una buena señal."

    # Mostrar un personaje en pantalla
    show chico at izquierda with dissolve

    mk "¡Ledesma! ¡Tengo una misión para vos!"

    # Cambiar la expresión del personaje
    show chico enfadado at izquierda with dissolve

    led "¿Por qué siento que voy a arrepentirme?"

    # Mostrar otro personaje a la derecha
    show chica at derecha with dissolve

    osi "¿Qué están haciendo?"

    # Reproducir un efecto de sonido
    play sound "sound/tower_clock.ogg"

    mk "¡Tenés que decirle algo importante a Osiris!"

    led "¡MANKITO!"

    # Ocultar un personaje
    hide chico with dissolve

    # Volver a mostrar el personaje con otra expresión
    show chico sonrie at izquierda with dissolve

    led "Bueno... quizá tenga algo que decirte."

    # Demostrar el volteo horizontal del sprite
    hide chico
    show chico volteado at izquierda with dissolve

    "Ledesma se da vuelta, intentando disimular sus nervios."

    # Movimiento entre posiciones
    show chico volteado at centro with move

    osi "¿Me lo vas a contar o no?"

    # --------------------------------------------------------
    # MENÚ: EL JUGADOR ELIGE UNA RUTA
    # --------------------------------------------------------

    menu:
        "Decir la verdad":
            jump final_bueno

        "Cambiar de tema":
            jump final_abierto


# ============================================================
# FINAL 1
# ============================================================

label final_bueno:

    scene atardecer2 with fade

    show chica at derecha with dissolve
    show chico sonrie at izquierda with dissolve

    led "Me gustás, Osiris."

    osi "Vos también me gustás."

    "Mankito celebra desde algún lugar del patio."

    mk "¡SABÍA QUE IBA A FUNCIONAR!"

    # Final de la primera ruta
    "FINAL 1: UNA CITA."

    return


# ============================================================
# FINAL 2
# ============================================================

label final_abierto:

    scene atardecer2 with fade

    show chica at derecha with dissolve
    show chico at izquierda with dissolve

    led "¿Viste el clima que va a hacer mañana?"

    osi "Ledesma... ¿en serio?"

    "Quizá otro día se anime a decir la verdad."

    # Final alternativo
    "FINAL 2: UNA OPORTUNIDAD PENDIENTE."

    return
